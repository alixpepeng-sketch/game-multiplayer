{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username','createdAt'])",
        "username": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 12" },
        "photo": { ".validate": "newData.isString() && newData.val().length < 600" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || (data.child('players').numChildren() < 2 && newData.child('players').child(auth.uid).exists()))",
        ".validate": "$code.matches(/^ALYZ-[A-Z]{6}$/) && (!newData.exists() || newData.child('name').val() === 'ALYZ MULTIPLAYER')",
        "players": { ".validate": "newData.numChildren() <= 2" }
      }
    }
  }
}
